# Copia este archivo como .env para ejecutar SIGEC en tu computador (NO subir .env a GitHub)
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Recuperación del Admin (solo si olvidó su clave): clave temporal de 8+ caracteres, se aplica una vez al arrancar
# ADMIN_RESET_PASSWORD=
# Opcional: asistente con Claude (API de Anthropic). NUNCA pongas la clave en el código ni la compartas.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Para abrir SIGEC desde el celular en la misma red, descomenta:
# HOST=0.0.0.0
# En la nube (Railway) estas variables se definen en el panel; ver RAILWAY.md
# DATA_DIR=/data
